---
import Layout from '../layouts/Layout.astro';
import { CheckoutFlow } from '../components/checkout/CheckoutFlow';

const title = "Checkout - Honduras Coffee";
const description = "Complete your Honduras coffee purchase";
---

<Layout title={title} description={description}>
  <main>
    <CheckoutFlow client:load />
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    background: linear-gradient(135deg, #f8f6f3 0%, #f3f1ee 100%);
  }
</style>