---
import Layout from '../../layouts/Layout.astro'
import { Card, CardContent, CardHeader, CardTitle } from '../../components/ui/card'
import { Button } from '../../components/ui/button'
import { Input } from '../../components/ui/input'
import { Label } from '../../components/ui/label'
import { Checkbox } from '../../components/ui/checkbox'
import { Alert, AlertDescription } from '../../components/ui/alert'
import { Coffee, Shield, AlertCircle } from 'lucide-react'
---

<Layout title="Admin Login | Honduras Coffee" description="Admin access to Honduras Coffee management system">
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-coffee-50 to-coffee-100 p-4">
    <Card class="w-full max-w-md admin-card">
      <CardHeader class="text-center space-y-4">
        <!-- Logo and branding -->
        <div class="flex justify-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-coffee-600 text-white shadow-lg">
            <Coffee class="h-6 w-6" />
          </div>
        </div>

        <div class="space-y-2">
          <CardTitle class="text-2xl font-bold text-coffee-900">Admin Access</CardTitle>
          <p class="text-coffee-600">Sign in to manage Honduras Coffee</p>
        </div>

        <!-- Security badge -->
        <div class="flex items-center justify-center gap-2 text-sm text-coffee-600">
          <Shield class="h-4 w-4" />
          <span>Secure Admin Portal</span>
        </div>
      </CardHeader>

      <CardContent>
        <form class="space-y-4" id="admin-login-form">

          <!-- Email field -->
          <div class="space-y-2">
            <Label htmlFor="email" class="text-coffee-700 font-medium">Email Address</Label>
            <Input
              id="email"
              type="email"
              placeholder="admin@hondurascoffee.com"
              required
              class="admin-input"
            />
          </div>

          <!-- Password field -->
          <div class="space-y-2">
            <Label htmlFor="password" class="text-coffee-700 font-medium">Password</Label>
            <Input
              id="password"
              type="password"
              placeholder="Enter your password"
              required
              class="admin-input"
            />
          </div>

          <!-- Remember me and forgot password -->
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <Checkbox id="remember" />
              <Label htmlFor="remember" class="text-sm text-coffee-600">Remember me</Label>
            </div>
            <a href="/admin/forgot-password" class="text-sm text-coffee-600 hover:text-coffee-800 transition-colors">
              Forgot password?
            </a>
          </div>

          <!-- Error alert (hidden by default) -->
          <Alert id="login-error" class="hidden border-red-200 bg-red-50">
            <AlertCircle class="h-4 w-4 text-red-600" />
            <AlertDescription class="text-red-700">
              Invalid email or password. Please try again.
            </AlertDescription>
          </Alert>

          <!-- Submit button -->
          <Button type="submit" class="w-full admin-button bg-coffee-600 hover:bg-coffee-700 text-white">
            <Shield class="mr-2 h-4 w-4" />
            Sign In to Admin Panel
          </Button>

          <!-- Additional security info -->
          <div class="text-center">
            <p class="text-xs text-coffee-500">
              This is a secure area. All access is logged and monitored.
            </p>
          </div>
        </form>
      </CardContent>
    </Card>
  </div>
</Layout>

<script>
  // Admin login form handling
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('admin-login-form') as HTMLFormElement
    const errorAlert = document.getElementById('login-error') as HTMLElement

    form?.addEventListener('submit', async (e) => {
      e.preventDefault()

      const formData = new FormData(form)
      const email = formData.get('email') as string
      const password = formData.get('password') as string

      try {
        // Hide any previous errors
        errorAlert.classList.add('hidden')

        // Show loading state
        const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement
        const originalText = submitButton.innerHTML
        submitButton.innerHTML = 'Signing in...'
        submitButton.disabled = true

        // Simulate API call (replace with actual Supabase auth)
        const response = await fetch('/api/admin/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email, password }),
        })

        if (response.ok) {
          // Redirect to admin dashboard
          window.location.href = '/admin'
        } else {
          // Show error
          errorAlert.classList.remove('hidden')
          submitButton.innerHTML = originalText
          submitButton.disabled = false
        }
      } catch (error) {
        console.error('Login error:', error)
        errorAlert.classList.remove('hidden')

        // Reset button
        const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement
        submitButton.innerHTML = 'Sign In to Admin Panel'
        submitButton.disabled = false
      }
    })

    // Auto-focus email field
    const emailInput = document.getElementById('email') as HTMLInputElement
    emailInput?.focus()
  })
</script>

<style>
  /* Admin login specific styling */
  .admin-card {
    @apply bg-white/90 backdrop-blur-md border border-white/30 shadow-2xl;
    border-radius: 20px;
    animation: fadeInUp 0.6s ease-out;
  }

  .admin-input {
    @apply transition-all duration-200 border-coffee-200 focus:border-coffee-500 focus:ring-coffee-500/20;
    border-radius: 12px;
  }

  .admin-input:focus {
    @apply shadow-lg transform scale-[1.02];
  }

  .admin-button {
    @apply transition-all duration-200 ease-out shadow-lg;
    border-radius: 12px;
  }

  .admin-button:hover {
    @apply transform translate-y-[-2px] shadow-xl;
  }

  .admin-button:active {
    @apply transform translate-y-[0px] shadow-md;
  }

  /* Coffee gradient background */
  .bg-gradient-to-br {
    background: linear-gradient(135deg,
      hsl(30, 25%, 98%) 0%,
      hsl(30, 20%, 95%) 50%,
      hsl(25, 15%, 92%) 100%
    );
  }

  /* Animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Coffee color variables */
  .text-coffee-900 { color: hsl(25, 45%, 20%); }
  .text-coffee-700 { color: hsl(25, 40%, 30%); }
  .text-coffee-600 { color: hsl(25, 35%, 35%); }
  .text-coffee-500 { color: hsl(25, 30%, 45%); }
  .bg-coffee-600 { background-color: hsl(25, 35%, 35%); }
  .bg-coffee-700 { background-color: hsl(25, 40%, 30%); }
  .bg-coffee-50 { background-color: hsl(30, 20%, 95%); }
  .bg-coffee-100 { background-color: hsl(30, 18%, 88%); }
  .border-coffee-200 { border-color: hsl(30, 16%, 82%); }
  .border-coffee-500 { border-color: hsl(25, 30%, 45%); }

  .hover\:bg-coffee-700:hover { background-color: hsl(25, 40%, 30%); }
  .hover\:text-coffee-800:hover { color: hsl(25, 42%, 25%); }
  .focus\:border-coffee-500:focus { border-color: hsl(25, 30%, 45%); }
  .focus\:ring-coffee-500\/20:focus {
    box-shadow: 0 0 0 3px hsla(25, 30%, 45%, 0.2);
  }
</style>