---
import Layout from '../../layouts/Layout.astro'
import PasswordReset from '../../components/auth/PasswordReset'
import { getSupabaseClient } from '../../lib/supabase/client'

export async function getStaticProps() {
  return {
    props: {
      title: 'Reset Password - Honduras Coffee'
    }
  }
}

const handleRequestReset = async (email: string) => {
  'use server'

  const supabase = getSupabaseClient()
  const { error } = await supabase.auth.resetPasswordForEmail(email, {
    redirectTo: `${Astro.site.origin}/auth/reset-password`
  })

  if (error) {
    throw new Error(error.message)
  }
}

const handleResetPassword = async (token: string, password: string) => {
  'use server'

  const supabase = getSupabaseClient()
  const { error } = await supabase.auth.updateUser({
    password: password
  })

  if (error) {
    throw new Error(error.message)
  }
}
---

<Layout title={Astro.props.title}>
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-amber-50 to-orange-50 dark:from-gray-900 dark:to-gray-800 px-4">
    <div class="w-full max-w-md">
      <PasswordReset
        onRequestReset={handleRequestReset}
        onResetPassword={handleResetPassword}
        resetToken={Astro.params.token}
        client:load
      />
    </div>
  </main>
</Layout>