---
// Honduras Coffee - User Account Dashboard Main Page
export const prerender = false;
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Account | Honduras Coffee</title>
  <meta name="description" content="Manage your Honduras Coffee account, orders, subscriptions, and preferences">
  <link rel="stylesheet" href="/src/styles/globals.css">
</head>
<body>
  <div id="account-app" class="min-h-screen bg-background">
    <!-- Loading state while React app initializes -->
    <div class="flex items-center justify-center min-h-screen">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
    </div>
  </div>
  
  <script>
    // Import React and ReactDOM for client-side rendering
    import React from 'react';
    import ReactDOM from 'react-dom/client';
    import { AccountApp } from './AccountApp';
    
    // Initialize React account dashboard
    const container = document.getElementById('account-app');
    if (container) {
      const root = ReactDOM.createRoot(container);
      root.render(React.createElement(AccountApp));
    }
  </script>
</body>
</html>