---
import MainLayout from '@/components/layout/MainLayout.astro'
import CategoryPage from '@/components/shop/CategoryPage'

export const prerender = true
---

<MainLayout
  title="Mountain Coffee Collection - Honduras Coffee Co."
  description="High-altitude mountain coffee with bright acidity and complex flavor notes. Grown in the pristine highlands of Honduras."
>
  <CategoryPage
    client:load
    category="mountain"
    categoryTitle="Mountain Collection"
    categoryDescription="Our Mountain Collection showcases high-altitude coffees grown in the pristine highlands of Honduras, where cooler temperatures and rich volcanic soil create bright, complex flavors."
    categoryBadge="High Altitude"
  />
</MainLayout>