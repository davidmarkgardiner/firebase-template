---
import Layout from '@/layouts/Layout.astro'
import ProductPageClient from '@/components/shop/ProductPageClient'
import { getProductBySlug, getProductVariants, getRelatedProducts, getProductReviews, getFarmInfo, getBrewingGuides, getReviewStats } from '@/lib/api/products'

export function getStaticPaths() {
  // Available product slugs - in production, this would fetch from your database
  return [
    { params: { slug: 'honduran-estate-reserve-250g' } },
    { params: { slug: 'mountain-peak-blend-500g' } },
    { params: { slug: 'seasonal-harvest-special' } },
    { params: { slug: 'single-origin-marcala-250g' } },
    { params: { slug: 'dark-roast-espresso-500g' } }
  ]
}

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/products')
}

// Fetch product data
const product = await getProductBySlug(slug)

if (!product) {
  return new Response(null, {
    status: 404,
    statusText: 'Product not found'
  })
}

// Fetch all related data in parallel
const [variants, reviews, reviewStats, relatedProducts, farmInfo, brewingGuides] = await Promise.all([
  getProductVariants(product.id),
  getProductReviews(product.id),
  getReviewStats(product.id),
  getRelatedProducts(product.id),
  getFarmInfo(product.id),
  getBrewingGuides(product.id)
])

// SEO Metadata
const seoTitle = `${product.name} - Honduras Mountain Coffee`
const seoDescription = product.description.length > 160 ? 
  `${product.description.substring(0, 157)}...` : 
  product.description

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.description,
  "image": product.images.map(img => img.url),
  "brand": {
    "@type": "Brand",
    "name": "Honduras Mountain Coffee"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": variants.length > 0 ? (Math.min(...variants.map(v => v.price)) / 100).toFixed(2) : (product.price / 100).toFixed(2),
    "highPrice": variants.length > 0 ? (Math.max(...variants.map(v => v.price)) / 100).toFixed(2) : (product.price / 100).toFixed(2),
    "availability": product.isAvailable ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "offerCount": variants.length
  },
  "aggregateRating": reviewStats.totalReviews > 0 ? {
    "@type": "AggregateRating",
    "ratingValue": reviewStats.averageRating,
    "reviewCount": reviewStats.totalReviews
  } : undefined
}
---

<Layout title={seoTitle} description={seoDescription}>
  <Fragment slot="head">
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={product.featuredImage} />
    <meta property="og:type" content="product" />
    <meta property="og:url" content={`https://hondurasmountaincoffee.com/products/${slug}`} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={product.featuredImage} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={`https://hondurasmountaincoffee.com/products/${slug}`} />
    
    <!-- Preload critical assets -->
    <link rel="preload" href={product.featuredImage} as="image" />
  </Fragment>

  <ProductPageClient
    client:load
    product={product}
    variants={variants}
    reviews={reviews}
    reviewStats={reviewStats}
    relatedProducts={relatedProducts}
    farmInfo={farmInfo}
    brewingGuides={brewingGuides}
  />
</Layout>