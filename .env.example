# Environment Template for Honduras Coffee E-commerce Platform
# Copy this file to .env.local for local development
# For production, set these variables in your deployment platform (Vercel/Railway)

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these values from your Supabase project dashboard
# Go to: Project Settings > API > URL and Project API keys

# Your Supabase project URL (exposed to browser)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (exposed to browser)
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (server-side only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================
# Get these from your Stripe dashboard
# Test keys for development, live keys for production

# Stripe publishable key (exposed to browser)
# Test: pk_test_... | Live: pk_live_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51AbC123...

# Stripe secret key (server-side only)
# Test: sk_test_... | Live: sk_live_...
STRIPE_SECRET_KEY=sk_test_51AbC123...

# Stripe webhook endpoint secret (for webhook verification)
# Get this when setting up webhooks in Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_1AbC123...

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Base URL for your application
# Local development: http://localhost:4321
# Production: https://your-domain.com
PUBLIC_APP_URL=http://localhost:4321

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# For transactional emails (order confirmations, etc.)
# Sign up at https://resend.com for API key

# Resend API key (server-side only)
RESEND_API_KEY=re_AbC123...

# From email address (must be verified domain)
RESEND_FROM_EMAIL=orders@hondurascoffee.eu

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
# For tracking and analytics

# Google Analytics measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Analytics (automatically detected in Vercel)
# No configuration needed if deployed to Vercel

# =============================================================================
# SECURITY & MISC
# =============================================================================
# JWT secret for session management (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Admin email for initial admin user setup
ADMIN_EMAIL=admin@hondurascoffee.eu

# Environment indicator
NODE_ENV=development