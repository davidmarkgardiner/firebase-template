# Claude Code Hooks Environment Configuration
# Copy your actual API keys here

# ElevenLabs API Key (for TTS hooks)
ELEVENLABS_API_KEY="${ELEVENLABS_API_KEY}"

# OpenAI API Key (fallback TTS)
# OPENAI_API_KEY=your_openai_key_here

# Engineer name for personalized messages (optional)
ENGINEER_NAME=David

# Hook configuration flags
ENABLE_TTS=true
ENABLE_LOGGING=true
ENABLE_VALIDATION=false