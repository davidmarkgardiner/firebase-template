# Development Environment Configuration
# Copy this to .env.local for local development

# Supabase Configuration (Development)
PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_dev_service_role_key

# Stripe Configuration (Test Mode)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# App Configuration
PUBLIC_APP_URL=http://localhost:4321
NODE_ENV=development

# Optional: Analytics and Monitoring (Development)
# PUBLIC_ANALYTICS_ID=your_dev_analytics_id
# PUBLIC_SENTRY_DSN=your_dev_sentry_dsn